APP_ENV=test
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=icube_test
DB_USER=icube_test_app
DB_PASSWORD=replace_me
DB_CONNECTION_LIMIT=10
TRUST_PROXY=1
PHOTO_STORAGE_DIR=/var/lib/icube-crm/lesson-photos
PHOTO_RETENTION_DAYS=30
PHOTO_MAX_UPLOAD_MB=5
PAYMENT_RECEIPT_STORAGE_DIR=./var/payment-receipts
PAYMENT_RECEIPT_MAX_UPLOAD_MB=10
APP_TIME_ZONE=Asia/Sakhalin
PARENT_MAX_URL=https://max.ru/example
PARENT_CONTACT_PHONE=+70000000000

# Web Push (VAPID private key must stay only in server environment)
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_BATCH_SIZE=50
PARENT_NOTIFICATION_TIME=19:00

# Игра «Остров чудиков»: не включать без проверки реального сервера (GAME_PLAN.md, этап 0)
GAME_ENABLED=false
GAME_INTERNAL_TOKEN=
GAME_INTERNAL_PORT=3001
# Ключ подписи разрешений на вход (не короче 32 символов, только в .env CRM, не равен GAME_INTERNAL_TOKEN). Пусто — вход по правилам этапа 2
GAME_LOGIN_GRANT_KEY=
# Только для внутренней сети без публичных адресов; на обычном сервере оставить false
GAME_ALLOW_PRIVATE_CLIENT_IP=false
# Обратный канал игры для бонусов сотрудников (этап 4): только 127.0.0.1, тот же GAME_INTERNAL_TOKEN
GAME_SERVER_INTERNAL_URL=http://127.0.0.1:3101
# Предел одной выдачи бонуса, 1–10 звёзд
GAME_BONUS_MAX_STARS=10
