APP_ENV=production
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=icube_prod
DB_USER=icube_prod_app
DB_PASSWORD=replace_me
DB_CONNECTION_LIMIT=20
TRUST_PROXY=1
PHOTO_STORAGE_DIR=/var/lib/icube-crm/lesson-photos
PHOTO_RETENTION_DAYS=30
PHOTO_MAX_UPLOAD_MB=5
PAYMENT_RECEIPT_STORAGE_DIR=/var/lib/icube-crm/payment-receipts
PAYMENT_RECEIPT_MAX_UPLOAD_MB=10

# Web Push (VAPID private key must stay only in server environment)
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_BATCH_SIZE=50
PARENT_NOTIFICATION_TIME=19:00
