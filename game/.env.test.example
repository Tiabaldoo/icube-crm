# Игровой сервер «Острова чудиков» на test. Файл — /opt/icube-game-test/game/.env, права 600, владелец icube-game.
# Production не поддерживается: сервер откажется запускаться при APP_ENV=production.
APP_ENV=test
GAME_PORT=3100

# Своя база игры. Пользователь — только с правами на icube_game_test, без доступа к базам CRM.
GAME_DB_HOST=127.0.0.1
GAME_DB_PORT=3306
GAME_DB_NAME=icube_game_test
GAME_DB_USER=icube_game_test_app
GAME_DB_PASSWORD=replace_me

# Внутренний API CRM: только 127.0.0.1. Секрет совпадает с GAME_INTERNAL_TOKEN в .env CRM (не короче 32 символов).
# GAME_LOGIN_GRANT_KEY CRM сюда не копировать: его знает только CRM.
GAME_CRM_INTERNAL_URL=http://127.0.0.1:3001
GAME_INTERNAL_TOKEN=

# Адрес, с которого открывается игра (проверка Origin), только https.
GAME_PUBLIC_ORIGIN=https://test.example.com
